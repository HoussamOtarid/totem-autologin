# totem-autologin config. Copy to autologin.env and keep it private (chmod 600).
# `totem-autologin setup` fills in the Whoop and relay lines for you.

# --- Whoop account ---
WHOOP_EMAIL=
WHOOP_PASSWORD=

# --- Gmail relay (apps-script/Code.gs) ---
CODE_URL=
CODE_KEY=
# 1 = email you when it logs in again or fails, 0 = no emails
NOTIFY=1

# --- How to check that totem is still logged in ---
# mcp:     call a tool on your running totem server (any HTTP setup)
# refresh: for a local install (Claude Desktop / Code starts totem itself)
CHECK=mcp
# For CHECK=mcp: the server's MCP URL and its MCP_AUTH_TOKEN
TOTEM_URL=https://your-totem-host/mcp
TOTEM_TOKEN=

# --- Where to save the new tokens ---
# envfile | fly | railway | cloudrun | huggingface | command
TARGET=envfile

# envfile: totem's .env file (Docker: the file mounted as /app/.env; local install: the .env in the totem folder)
ENV_FILE=
# envfile, optional: command that restarts totem so it loads the new tokens (e.g. docker restart totem)
RESTART_COMMAND=

# fly
FLY_APP=

# railway (optional when the folder is already linked)
RAILWAY_PROJECT=
RAILWAY_SERVICE=

# cloudrun
CLOUDRUN_SERVICE=
CLOUDRUN_REGION=
CLOUDRUN_PROJECT=

# huggingface: Space id (user/space) and a token with write access
HF_SPACE=
HF_TOKEN=

# command: runs with WHOOP_IOS_BEARER_TOKEN and WHOOP_COGNITO_REFRESH_TOKEN set
TOKENS_COMMAND=
